# ─────────────────────────────────────────────────────────────────────────────
# UniFi Network SIEM — bootstrap configuration
# ─────────────────────────────────────────────────────────────────────────────
# As of Phase 2 of the fix plan, almost all operator-facing settings live in
# the SQLite `settings` table and are managed via the Settings UI. .env now
# only carries the handful of values that are needed BEFORE the DB is open,
# plus optional headless/CI overrides.
#
# Any setting set here on first run is seeded into the DB (DB wins on
# subsequent reads — matches the AbuseIPDB precedent). To change other
# settings (syslog port, retention, AbuseIPDB key, OpenSearch host, Threat
# Hunt model, etc.), open the dashboard → Settings.
# ─────────────────────────────────────────────────────────────────────────────

# True bootstrap — needed before storage is open
DB_PATH=./data/events.db
LOG_LEVEL=info

# HTTPS bind address — 127.0.0.1 = localhost only (default).
# Set to your LAN IP or 0.0.0.0 for remote dashboard access.
HTTP_HOST=127.0.0.1

# ─────────────────────────────────────────────────────────────────────────────
# Optional headless / CI overrides
# ─────────────────────────────────────────────────────────────────────────────
# If unset, the SIEM auto-generates these on first run and logs them ONCE
# to stdout. Save them off to your secrets manager. Subsequent restarts
# read them silently from the encrypted DB.

# SIEM_MASTER_KEY=    # 64 hex chars (32 bytes). Decrypts sensitive settings.
# SIEM_API_TOKEN=     # 64 hex chars. Required for /api and /ws auth (Phase 3+).

# ─────────────────────────────────────────────────────────────────────────────
# First-run seeding (optional — these populate the DB on first run only)
# ─────────────────────────────────────────────────────────────────────────────
# Any of the following will seed the corresponding DB row on first run.
# After that, the DB is the source of truth — edit via Settings UI.
# Uncomment + set to pre-populate a fresh deployment.

# SYSLOG_PORT=5514
# HTTP_PORT=3000
# RETENTION_DAYS=60
# GEOIP_DB_PATH=./data/GeoLite2-City.mmdb
# ABUSEIPDB_API_KEY=
# ABUSEIPDB_CACHE_HOURS=24
# RDNS_ENABLED=false
# RDNS_TIMEOUT_MS=2000
# ENRICHMENT_CONCURRENCY=5
# INSERT_BATCH_SIZE=50
# INSERT_BATCH_INTERVAL_MS=500
# WS_BROADCAST_THROTTLE_MS=100
# WARDSONDB_HEALTH_TIMEOUT_MS=5000
# WARDSONDB_CONNECT_TIMEOUT_MS=60000
# WARDSONDB_QUERY_TIMEOUT_MS=0
# WARDSONDB_FLUSH_CONCURRENCY=4
# OPENSEARCH_HOST=localhost
# OPENSEARCH_PORT=9200
# OPENSEARCH_USERNAME=
# OPENSEARCH_PASSWORD=
# OPENSEARCH_USE_TLS=false
# OPENSEARCH_VERIFY_CERTS=true
# OPENSEARCH_INDEX_PREFIX=siem-
# OPENSEARCH_BULK_SIZE=50
# HEALTH_REBUILDING_DEBOUNCE_POLLS=2
# LOG_RAW_MESSAGES=false
