# Network
SYSLOG_PORT=5514
HTTP_PORT=3000

# Database
DB_PATH=./data/events.db
RETENTION_DAYS=60

# Enrichment (Phase 4)
GEOIP_DB_PATH=./data/GeoLite2-City.mmdb
ABUSEIPDB_API_KEY=
ABUSEIPDB_CACHE_HOURS=24
RDNS_ENABLED=false
RDNS_TIMEOUT_MS=2000

# Performance
INSERT_BATCH_SIZE=50
INSERT_BATCH_INTERVAL_MS=500
ENRICHMENT_CONCURRENCY=5
WS_BROADCAST_THROTTLE_MS=100

# WardSONDB (optional — only applies when WardSONDB backend is active)
WARDSONDB_HEALTH_TIMEOUT_MS=5000
# TCP connect timeout — raise above undici's 10s default if you see
# `Connect Timeout Error` under heavy ingest/flush load.
WARDSONDB_CONNECT_TIMEOUT_MS=60000
# Client-side request timeout in ms — 0 disables it and lets the server
# --query-timeout flag govern duration (recommended for Threat Hunt).
WARDSONDB_QUERY_TIMEOUT_MS=0
# Rollup flush worker concurrency — lower values reduce pressure on
# WardSONDB's connection accept loop during heavy ingest.
WARDSONDB_FLUSH_CONCURRENCY=4

# Logging
LOG_LEVEL=info
LOG_RAW_MESSAGES=false
